<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!--
        Phone-number pairing code. Tapping the card copies the code to the clipboard,
        so the code can be pasted anywhere (e.g. a password manager) while the
        WebView session keeps waiting for the link to be approved.
    -->
    <TextView
        android:id="@+id/codeBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_margin="12dp"
        android:background="@drawable/bg_pairing_code"
        android:clickable="true"
        android:elevation="8dp"
        android:focusable="true"
        android:fontFamily="monospace"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:padding="14dp"
        android:textColor="#ffffff"
        android:textSize="15sp"
        android:visibility="gone" />

</FrameLayout>
